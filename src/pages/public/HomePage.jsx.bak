                  <span>View Details</span>
                  <ChevronRight className="w-3.5 h-3.5" />
                </Link>

                <Link
                  to="/contact"
                  className="px-4 py-1.5 bg-gradient-to-r from-[#E02B91] to-[#8B2BE2] hover:opacity-95 text-white font-bold text-xs rounded-full shadow-xs transition"
                >
                  Enroll
                </Link>
              </div>
            </div>
          ))}
        </div>

        {/* Explore Courses Button Below the 3 Domains */}
        <div className="flex justify-center pt-2">
          <Link
            to="/courses"
            className="px-8 py-3.5 bg-gradient-to-r from-[#E02B91] to-[#8B2BE2] hover:opacity-95 text-white font-bold text-xs sm:text-sm rounded-full shadow-md shadow-pink-500/20 hover:shadow-lg transition flex items-center space-x-2"
          >
            <span>Explore Courses</span>
            <ArrowRight className="w-4 h-4" />
          </Link>
        </div>
      </section>

      {/* =========================================================================
          6. TRENDING COURSES
         ========================================================================= */}
      <section className="bg-white py-14 border-y border-[#E5E7EB]">
        <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10">
          <div className="text-center max-w-2xl mx-auto space-y-2">
            <span className="text-[10px] font-bold uppercase tracking-wider text-[#E02B91] bg-pink-50 px-3.5 py-1 rounded-full border border-pink-200 shadow-2xs">
              🔥 High Industry Demand
            </span>
            <h2 className="text-3xl font-black text-[#111827]">
              Trending Courses
            </h2>
            <p className="text-xs text-[#4B5563]">
              Top-ranked technology programs chosen by modern computer science students and working engineers.
            </p>
          </div>

          <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
            {trendingCourses.slice(0, 4).map((tc, idx) => (
              <div
                key={idx}
                className="bg-white rounded-2xl border border-[#E5E7EB] p-5 shadow-xs hover:border-pink-300 hover:shadow-md transition space-y-3 relative hover:-translate-y-1 duration-200"
              >
                <div className="flex items-center justify-between">
                  <span className="text-[10px] font-bold bg-pink-50 text-[#E02B91] px-2.5 py-0.5 rounded-full border border-pink-200">
                    🔥 Trending
                  </span>
                  <span className="text-[11px] font-mono text-[#8B2BE2] font-bold">
                    {tc.studentsEnrolled}+ Enrolled
                  </span>
                </div>

                <h3 className="text-base font-black text-[#111827] leading-snug">
                  {tc.title}
                </h3>

                <p className="text-xs text-[#4B5563] line-clamp-2">
                  {tc.description}
                </p>

                <div className="pt-2 border-t border-[#E5E7EB] flex items-center justify-between text-xs">
                  <span className="font-semibold text-[#6B7280]">{tc.duration}</span>
                  <Link
                    to="/courses"
                    className="font-bold text-[#E02B91] hover:text-[#8B2BE2]"
                  >
                    View Details &rarr;
                  </Link>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>

      {/* =========================================================================
          7. INTERNSHIP PROGRAMS – ONE HORIZONTAL ROW + EXPLORE MORE
         ========================================================================= */}
      <section className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6">
        <div className="flex flex-col sm:flex-row sm:items-end justify-between gap-4">
          <div className="space-y-1.5">
            <span className="text-[10px] font-bold uppercase tracking-wider text-emerald-700 bg-emerald-50 px-3 py-1 rounded-full border border-emerald-200 shadow-2xs">
              Workplace Experience
            </span>
            <h2 className="text-3xl font-black text-[#111827]">
              Internship Programs
            </h2>
            <p className="text-xs text-[#4B5563]">
              Select from over <strong>50+ Internship Domains</strong> spanning software engineering, data science, and cloud operations.
            </p>
          </div>

          <Link
            to="/internships"
            className="px-5 py-2.5 bg-emerald-50 hover:bg-emerald-100 text-emerald-700 font-bold text-xs rounded-full border border-emerald-200 transition flex items-center space-x-1.5 shrink-0 self-start sm:self-auto shadow-2xs"
          >
            <span>Explore More →</span>
          </Link>
        </div>

        {/* Horizontal Single Row Container */}
        <div className="relative">
          <div className="flex gap-6 overflow-x-auto pb-4 pt-1 px-1 scroll-smooth snap-x snap-mandatory">
            {featuredInternships.map((intern, idx) => (
              <div
                key={idx}
                className="w-[280px] sm:w-[320px] md:w-[340px] shrink-0 snap-start bg-white rounded-2xl border border-[#E5E7EB] p-5 shadow-xs hover:border-emerald-300 hover:shadow-md transition flex flex-col justify-between space-y-3 hover:-translate-y-1 duration-200"
              >
                <div className="space-y-2">
                  <div className="flex items-center justify-between">
                    <span className="text-[10px] font-bold uppercase tracking-wider text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded border border-emerald-200">
                      {intern.mode}
                    </span>
                    <span className="text-[10px] font-bold text-[#6B7280]">
                      {intern.duration}
                    </span>
                  </div>

                  <h3 className="text-base font-black text-[#111827] leading-snug">
                    {intern.title}
                  </h3>

                  <p className="text-xs text-[#4B5563] font-medium line-clamp-2">
                    {intern.technology}
                  </p>

                  <div className="flex items-center space-x-1 text-xs text-emerald-700 font-semibold pt-1">
                    <ShieldCheck className="w-3.5 h-3.5 text-emerald-600" />
                    <span>Certificate Included</span>
                  </div>
                </div>

                <div className="pt-3 border-t border-[#E5E7EB] flex items-center justify-between">
                  <Link
                    to="/internships"
                    className="text-xs font-bold text-emerald-600 hover:text-emerald-700"
                  >
                    View Details
                  </Link>

                  <Link
                    to="/contact"
                    className="px-3.5 py-1.5 bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs rounded-full shadow-xs transition"
                  >
                    Apply
                  </Link>
                </div>
              </div>
            ))}

            {/* Explore More Card at End of Row */}
            <Link
              to="/internships"
              className="w-[240px] sm:w-[280px] shrink-0 snap-start bg-gradient-to-br from-emerald-50/70 via-white to-emerald-100/40 rounded-2xl border-2 border-dashed border-emerald-300 p-6 flex flex-col items-center justify-center text-center space-y-4 hover:border-emerald-500 hover:shadow-md transition group/btn"
            >
              <div className="w-14 h-14 rounded-2xl bg-emerald-600 text-white flex items-center justify-center shadow-md group-hover/btn:scale-110 transition-transform">
                <ArrowRight className="w-7 h-7" />
              </div>
              <div className="space-y-1">
                <span className="text-base font-black text-[#111827] group-hover/btn:text-emerald-600 transition-colors flex items-center justify-center gap-1">
                  Explore More <ArrowRight className="w-4 h-4" />
                </span>
                <p className="text-xs text-[#4B5563]">
                  View all 50+ certified internship domains &amp; real projects
                </p>
              </div>
              <span className="px-4 py-2 bg-emerald-600 group-hover/btn:bg-emerald-700 text-white text-xs font-bold rounded-full shadow-xs transition">
                All Internships (50+) &rarr;
              </span>
            </Link>
          </div>
        </div>
      </section>

      {/* =========================================================================
          8. OUR PRODUCTS – ONE HORIZONTAL ROW + EXPLORE MORE
         ========================================================================= */}
      <section className="bg-white py-14 border-y border-[#E5E7EB]">
        <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6">
          <div className="flex flex-col sm:flex-row sm:items-end justify-between gap-4">
            <div className="space-y-1.5">
              <span className="text-[10px] font-bold uppercase tracking-wider text-[#E02B91] bg-pink-50 px-3 py-1 rounded-full border border-pink-200 shadow-2xs">
                Software Engineering Portfolio
              </span>
              <h2 className="text-3xl font-black text-[#111827]">
                Our Products
              </h2>
              <p className="text-xs text-[#4B5563]">
                Software products developed by STACK QUEUE engineers and internship students solving enterprise problems.
              </p>
            </div>

            <Link
              to="/products"
              className="px-5 py-2.5 bg-slate-900 hover:bg-slate-800 text-white font-bold text-xs rounded-full border border-transparent transition flex items-center space-x-1.5 shrink-0 self-start sm:self-auto shadow-xs"
            >
              <span>Explore More →</span>
            </Link>
          </div>

          {/* Horizontal Single Row Container */}
          <div className="relative">
            <div className="flex gap-6 overflow-x-auto pb-4 pt-1 px-1 scroll-smooth snap-x snap-mandatory">
              {products.map((prod, idx) => (
                <div
                  key={idx}
                  className="w-[280px] sm:w-[320px] md:w-[340px] shrink-0 snap-start bg-white rounded-2xl border border-[#E5E7EB] p-6 shadow-xs hover:shadow-md hover:border-pink-300 transition flex flex-col justify-between space-y-4 hover:-translate-y-1 duration-200"
                >
                  <div className="space-y-3">
                    <div className="flex items-center justify-between">
                      <span className="text-[10px] font-bold uppercase tracking-wider text-[#E02B91] bg-pink-50 px-2.5 py-1 rounded-full border border-pink-200">
                        {prod.category}
                      </span>
                      <div className="w-8 h-8 rounded-xl bg-pink-50 border border-pink-200 flex items-center justify-center text-[#E02B91]">
                        <Rocket className="w-4 h-4" />
                      </div>
                    </div>

                    <h3 className="text-lg font-black text-[#111827]">
                      {prod.name}
                    </h3>

                    <p className="text-xs text-[#4B5563] leading-relaxed line-clamp-3">
                      {prod.shortDescription}
                    </p>

                    <div className="p-2.5 bg-slate-50 rounded-xl border border-[#E5E7EB] font-mono text-[11px] text-[#374151] font-semibold">
                      {prod.technology}
                    </div>
                  </div>

                  <div className="pt-3 border-t border-[#E5E7EB] flex items-center justify-between">
                    <Link
                      to={prod.demoUrl && prod.demoUrl.startsWith('/') ? prod.demoUrl : '/contact'}
                      className="text-xs font-bold text-[#E02B91] hover:text-[#8B2BE2] flex items-center space-x-1"
                    >
                      <span>View Product</span>
                      <ExternalLink className="w-3.5 h-3.5" />
                    </Link>

                    <Link
                      to="/products"
                      className="text-xs font-semibold text-[#6B7280] hover:text-[#111827]"
                    >
                      Product Specs
                    </Link>
                  </div>
                </div>
              ))}

              {/* Explore More Card at End of Row */}
              <Link
                to="/products"
                className="w-[240px] sm:w-[280px] shrink-0 snap-start bg-gradient-to-br from-pink-50/50 via-white to-purple-50/50 rounded-2xl border-2 border-dashed border-pink-300 p-6 flex flex-col items-center justify-center text-center space-y-4 hover:border-pink-500 hover:shadow-md transition group/btn"
              >
                <div className="w-14 h-14 rounded-2xl bg-gradient-to-r from-[#E02B91] to-[#8B2BE2] text-white flex items-center justify-center shadow-md group-hover/btn:scale-110 transition-transform">
                  <ArrowRight className="w-7 h-7" />
                </div>
                <div className="space-y-1">
                  <span className="text-base font-black text-[#111827] group-hover/btn:text-[#E02B91] transition-colors flex items-center justify-center gap-1">
                    Explore More <ArrowRight className="w-4 h-4" />
                  </span>
                  <p className="text-xs text-[#4B5563]">
                    View all software applications, developer tools &amp; live demos
                  </p>
                </div>
                <span className="px-4 py-2 bg-gradient-to-r from-[#E02B91] to-[#8B2BE2] hover:opacity-95 text-white text-xs font-bold rounded-full shadow-xs transition">
                  All Products &rarr;
                </span>
              </Link>
            </div>
          </div>
        </div>
      </section>

      {/* =========================================================================
          9. SPECIAL OFFERS
         ========================================================================= */}
      <section className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div className="text-center max-w-2xl mx-auto mb-10 space-y-2">
          <span className="text-[10px] font-bold uppercase tracking-wider text-[#E02B91] bg-pink-50 px-3.5 py-1 rounded-full border border-pink-200 shadow-2xs">
            Limited Enrollments
          </span>
          <h2 className="text-3xl font-black text-[#111827]">
            Special Offers &amp; Grants
          </h2>
          <p className="text-xs text-[#4B5563]">
            Scholarship grants and dual-domain accelerator discounts active for upcoming batches.
          </p>
        </div>

        <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
          {specialOffers.map((off, idx) => (
            <div
              key={idx}
              className="bg-white rounded-2xl border border-[#E5E7EB] p-6 shadow-xs hover:border-pink-300 hover:shadow-md transition flex flex-col justify-between space-y-4 hover:-translate-y-1 duration-200"
            >
              <div className="space-y-3">
                <div className="flex items-center justify-between">
                  <span className="text-xs font-black text-[#E02B91] bg-pink-50 px-3 py-1 rounded-full border border-pink-200">
                    {off.discount}
                  </span>
                  <span className="text-[11px] font-semibold text-[#6B7280]">
                    {off.type}
                  </span>
                </div>

                <h3 className="text-base font-black text-[#111827]">
                  {off.title}
                </h3>

                <p className="text-xs text-[#4B5563] leading-relaxed">
                  {off.description}
                </p>

                <span className="text-[11px] font-semibold text-[#6B7280] block">
                  ⏰ {off.validity}
                </span>
              </div>

              <div className="pt-3 border-t border-[#E5E7EB]">
                <Link
                  to="/contact"
                  className="w-full py-2.5 bg-gradient-to-r from-[#E02B91] to-[#8B2BE2] hover:opacity-95 text-white font-bold text-xs rounded-full transition flex items-center justify-center space-x-1.5 shadow-xs"
                >
                  <span>Claim Offer &amp; Register</span>
                  <ArrowRight className="w-3.5 h-3.5" />
                </Link>
              </div>
            </div>
          ))}
        </div>
      </section>

      {/* =========================================================================
          10. WHY CHOOSE US – 10 FEATURE CARDS
         ========================================================================= */}
      <section className="bg-white py-14 border-y border-[#E5E7EB]">
        <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10">
          <div className="text-center max-w-2xl mx-auto space-y-2">
            <span className="text-[10px] font-bold uppercase tracking-wider text-[#E02B91] bg-pink-50 px-3.5 py-1 rounded-full border border-pink-200 shadow-2xs">
              Institutional Excellence
            </span>
            <h2 className="text-3xl font-black text-[#111827]">
              Why Choose STACK QUEUE
            </h2>
            <p className="text-xs text-[#4B5563]">
              Built on ten pillars of practical engineering rigor, verified industry certifications, and career outcomes.
            </p>
          </div>

          <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4">
            {whyChooseUs.map((w, idx) => (
              <div
                key={idx}
                className="bg-white rounded-2xl border border-[#E5E7EB] p-5 shadow-xs hover:border-pink-200 hover:shadow-md transition space-y-2 hover:-translate-y-1 duration-200"
              >
                <div className="w-8 h-8 rounded-lg bg-pink-50 text-[#E02B91] flex items-center justify-center font-bold text-xs">
                  {idx + 1}
                </div>
                <h3 className="text-sm font-black text-[#111827] leading-snug">
                  {w.title}
                </h3>
                <p className="text-xs text-[#4B5563] leading-relaxed">
                  {w.desc}
                </p>
              </div>
            ))}
          </div>
        </div>
      </section>

      {/* =========================================================================
          11. YOUR LEARNING JOURNEY – ANIMATED TIMELINE
         ========================================================================= */}
      <section className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div className="text-center max-w-2xl mx-auto mb-14 space-y-2">
          <span className="text-[10px] font-bold uppercase tracking-wider text-[#E02B91] bg-pink-50 px-3.5 py-1 rounded-full border border-pink-200 shadow-2xs">
            Proven Career Trajectory
          </span>
          <h2 className="text-3xl font-black text-[#111827]">
            Your Learning Journey
          </h2>
          <p className="text-xs text-[#4B5563]">
            A step-by-step roadmap from your first code line to an enterprise engineering placement.
          </p>
        </div>

        {/* Desktop Horizontal Timeline / Mobile Vertical */}
        <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-6 gap-4 relative">
          {learningJourney.map((step, idx) => (
            <div
              key={idx}
              className="bg-white rounded-2xl border border-[#E5E7EB] p-5 shadow-xs hover:border-pink-200 hover:shadow-md transition space-y-3 relative flex flex-col justify-between"
            >
              <div className="space-y-2">
                <div className="flex items-center justify-between">
                  <span className="w-7 h-7 rounded-full bg-gradient-to-r from-[#E02B91] to-[#8B2BE2] text-white font-mono font-black text-xs flex items-center justify-center shadow-xs">
                    {step.step}
                  </span>
                  {idx < learningJourney.length - 1 && (
                    <span className="text-xs font-bold text-slate-400 hidden lg:inline">→</span>
                  )}
                </div>

                <h3 className="text-base font-black text-[#111827]">
                  {step.title}
                </h3>

                <p className="text-xs text-[#4B5563] leading-relaxed">
                  {step.desc}
                </p>
              </div>

              <div className="pt-2 border-t border-[#E5E7EB] text-[11px] font-bold text-[#E02B91]">
                Stage 0{step.step}
              </div>
            </div>
          ))}
        </div>
      </section>
    </div>
  );
}
